#!/bin/sh
# Refuse to push Go changes when statement coverage is below the floor.
#
# The floor is checked here rather than on commit because coverage is a property
# of the branch you are publishing, not of each step along the way. A commit that
# lowers coverage while you are mid-refactor is fine; pushing it is what makes it
# everyone else's problem.
#
# Measurement and the floor comparison themselves live in
# `go run ./cmd/codeflux-dev test-coverage --min-coverage`, which is the same
# command CI runs, so the hook and CI enforce identically: a failing suite is
# refused rather than measured, and coverage below the floor fails the run. Only
# the "does this push even carry a Go change" decision stays here, because it
# depends on the local/remote ref pair git hands a pre-push hook, which
# test-coverage -- an ordinary command with no notion of a push -- cannot see.
#
# REPO-028: the default floor below is a ratchet, not AGENTS.md's 80% target --
# 80% is unreachable from the measured baseline and would just be bypassed
# until met. It must equal cmd/codeflux-dev/coverage_floor.go's
# coverageFloorPercent; TestPrePushDefaultFloorMatchesRatchetConstant fails if
# the two drift apart. Raise both together, deliberately, once a higher number
# has actually been measured -- never lower either to get a push through.
#
# Bypass with --no-verify only when the user has explicitly asked for it.

set -eu

cd "$(git rev-parse --show-toplevel)"

MIN_COVERAGE="${CODEFLUX_MIN_COVERAGE:-60.0}"
GOTOOLCHAIN=local
export GOTOOLCHAIN

# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
# Collect the Go files this push would actually publish. A push carrying only
# ledger entries, documentation, or workflow files has no coverage to measure,
# and blocking it would only teach people to bypass the hook.
zero='0000000000000000000000000000000000000000'
changed_go=''
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"                            # new branch: inspect its tip
    files=$(git diff-tree --no-commit-id --name-only -r "$range" -- '*.go' || true)
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha" -- '*.go' || true)
  fi
  changed_go="$changed_go$files"
done

if [ -z "$changed_go" ]; then
  echo "pre-push: no Go changes in this push; coverage floor not applicable"
  exit 0
fi

echo "pre-push: measuring statement coverage (floor ${MIN_COVERAGE}%)"

# --min-coverage is passed explicitly, derived from CODEFLUX_MIN_COVERAGE (or
# the ratchet default) above, so this invocation's floor is never ambiguous:
# the flag test-coverage receives always wins over any environment variable a
# caller happened to also have set. test-coverage itself refuses rather than
# measuring when the suite fails, and reports the percentage and floor either
# way.
if ! go run ./cmd/codeflux-dev test-coverage --min-coverage "$MIN_COVERAGE"; then
  exit 1
fi
