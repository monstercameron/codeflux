#!/bin/sh
# Format, lint, and test before a commit is allowed.
#
# The point is to fail here rather than on GitHub. A red CI run costs a push, a
# wait, and a context switch; this costs the wait alone, and catches the failure
# while the change is still in your head.
#
# Bypass with --no-verify only when the user has explicitly asked for it. An
# agent does not get to decide the gate is inconvenient.

set -eu

cd "$(git rev-parse --show-toplevel)"

GOTOOLCHAIN=local
export GOTOOLCHAIN

# Only Go changes need the Go gates. A commit touching CHANGELOG, DEVLOG, or a
# workflow file has nothing for gofmt, staticcheck, or the test suite to say,
# and making a ledger-only commit wait several minutes teaches people to reach
# for --no-verify, which is worse than not having the hook at all.
staged_go=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go' || true)

if [ -z "$staged_go" ]; then
  echo "pre-commit: no staged Go files; skipping format, lint, and tests"
  exit 0
fi

# 1. Format. Staged files are rewritten in place and re-staged, because failing
#    a commit over whitespace the tool can fix itself is pure friction.
unformatted=$(printf '%s\n' "$staged_go" | xargs gofmt -l 2>/dev/null || true)
if [ -n "$unformatted" ]; then
  echo "pre-commit: formatting:"
  printf '  %s\n' $unformatted
  printf '%s\n' "$unformatted" | xargs gofmt -w
  printf '%s\n' "$unformatted" | xargs git add
  echo "pre-commit: reformatted and re-staged the files above"
fi

# 2. Lint: gofmt, vet, staticcheck, migrations, and the secret scan.
echo "pre-commit: lint"
go run ./cmd/codeflux-dev lint

# 3. Unit tests, for the packages this commit touches only.
#
# This runs untagged, so anything behind the `integration` build tag that
# `codeflux-dev test-integration` adds is never built here. Note that no file
# currently carries that tag, which means the two suites presently select the
# same tests — the separation is declared but not yet real. Scoping is therefore
# what actually keeps this fast, not the tag.
#
# The scope is the changed packages rather than ./... because the whole-repository
# run is not a unit run: internal/coordinator's engine test builds and executes
# generated programs and takes over nine minutes on its own, as main.go says
# where it raises the timeout to twenty. Waiting that out on every commit is what
# makes people reach for --no-verify. Touching internal/coordinator will still
# pay it, until the heavy tests are tagged.
#
# A change here can still break a dependent package. That is caught by the full
# suite at push time and again by CI; this hook is the fast, narrow layer of that
# ladder, not the whole of it.
# testdata is excluded because it is not a package. The Go tool ignores such
# directories precisely so fixtures can be invalid on purpose; naming one
# explicitly overrides that and builds it. cmd/codeflux-dev/testdata/atomdocs
# holds seven lint fixtures that all declare the same identifier, so it cannot
# compile by design — and without this filter no commit touching a fixture could
# ever pass the hook.
packages=$(printf '%s\n' "$staged_go" | xargs -n1 dirname | sort -u |
  grep -v -e '/testdata$' -e '/testdata/' | sed 's#^#./#')
if [ -z "$packages" ]; then
  echo "pre-commit: no testable packages staged; skipping unit tests"
  packages=""
fi
if [ -n "$packages" ]; then
  echo "pre-commit: unit tests for:"
  printf '  %s\n' $packages
  go test -timeout=5m $packages
fi

# 4. Confirm nothing disposable escaped into the tree.
echo "pre-commit: artifact-check"
go run ./cmd/codeflux-dev artifact-check

echo "pre-commit: ok"
